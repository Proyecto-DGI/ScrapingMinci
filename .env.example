# ============================================================
# ARCHIVO DE EJEMPLO - Copiar como .env y completar valores
# NUNCA subir el archivo .env a Git o compartirlo
# ============================================================

# Credenciales CvLAC (ScienTI - MinCiencias)
SCIENTI_NOMBRE=
SCIENTI_IDENTIFICACION=
SCIENTI_CONTRASENA=
SCIENTI_NACIONALIDAD=C

# Códigos de grupos GrupLAC (se autocompletán con --find-groups)
# Una vez encontrados, pegar aquí separados por coma
SCIENTI_GRUPOS=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upb_investigacion
DB_USER=postgres
DB_PASSWORD=
